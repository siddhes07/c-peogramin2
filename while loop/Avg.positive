#include <stdio.h>

int main() {
    int num, count = 0;
    float sum = 0, average;

    printf("Enter positive numbers (enter a negative number to stop):\n");

    while (1) {
        scanf("%d", &num);

        if (num < 0) {      // stop when negative number is entered
            break;
        }

        sum += num;
        count++;
    }

    if (count == 0) {
        printf("No positive numbers entered.\n");
    } else {
        average = sum / count;
        printf("Average of positive numbers = %.2f\n", average);
    }

    return 0;
}
